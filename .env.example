FACE_CHALLENGE_TTL_SECONDS=90
FACE_CHALLENGE_FRAMES_PER_STAGE=3
FACE_CHALLENGE_MIN_DURATION_MS=1500
FACE_CHALLENGE_YAW_DELTA=0.14
FACE_CHALLENGE_RETURN_TOLERANCE=0.08
FACE_ANTISPOOF_THRESHOLD=0.70
