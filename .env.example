FACE_VERIFICATION_TTL_MS=180000
FACE_REQUEST_TIMEOUT_MS=15000
FACE_SEQUENCE_TIMEOUT_MS=45000
FACE_RATE_LIMIT=10
FACE_ASSESS_RATE_LIMIT=100
FACE_MAX_UPLOAD_BYTES=5242880
FACE_FRAME_MAX_UPLOAD_BYTES=1048576
FACE_SEQUENCE_MAX_UPLOAD_BYTES=6291456
INSIGHTFACE_MODEL_NAME=buffalo_l
